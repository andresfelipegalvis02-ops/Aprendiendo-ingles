
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>English for New students | Curso Interactivo A1-A2</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 50%, #3d7ab5 100%);
            min-height: 100vh;
            color: #333;
        }
        .serif { font-family: 'Playfair Display', serif; }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }
        .progress-bar {
            height: 8px;
            background: #e5e7eb;
            border-radius: 4px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #10b981, #34d399);
            border-radius: 4px;
            transition: width 0.5s ease;
        }
        .option-btn {
            transition: all 0.3s ease;
            border: 2px solid #e5e7eb;
        }
        .option-btn:hover {
            transform: translateX(10px);
            border-color: #3b82f6;
            background: #eff6ff;
        }
        .option-btn.correct {
            background: #d1fae5;
            border-color: #10b981;
            color: #065f46;
        }
        .option-btn.incorrect {
            background: #fee2e2;
            border-color: #ef4444;
            color: #991b1b;
        }
        .option-btn.disabled {
            pointer-events: none;
            opacity: 0.7;
        }
        .floating-emoji {
            position: fixed;
            font-size: 2rem;
            pointer-events: none;
            animation: floatUp 3s ease-out forwards;
            z-index: 9999;
        }
        @keyframes floatUp {
            0% { opacity: 1; transform: translateY(0) scale(0); }
            50% { transform: translateY(-100px) scale(1.2); }
            100% { opacity: 0; transform: translateY(-300px) scale(0.8); }
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.875rem;
            font-weight: 600;
        }
        .badge-beginner { background: #dbeafe; color: #1e40af; }
        .badge-elementary { background: #dcfce7; color: #166534; }
        .score-circle {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: conic-gradient(#10b981 var(--score-deg), #e5e7eb var(--score-deg));
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .score-circle::before {
            content: '';
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: white;
        }
        .score-text {
            position: relative;
            z-index: 1;
            font-size: 2.5rem;
            font-weight: 800;
            color: #1f2937;
        }
        .topic-card {
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .topic-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }
        .topic-card.locked {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .topic-card.completed { border: 3px solid #10b981; }
        .audio-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #3b82f6;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
        }
        .audio-btn:hover {
            transform: scale(1.1);
            background: #2563eb;
        }
        .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            animation: confetti-fall 3s ease-out forwards;
        }
        @keyframes confetti-fall {
            0% { opacity: 1; transform: translateY(-100vh) rotate(0deg); }
            100% { opacity: 0; transform: translateY(100vh) rotate(720deg); }
        }
    </style>
</head>
<body>
    <div class="fixed top-0 left-0 right-0 z-50 bg-white/10 backdrop-blur-md p-4">
        <div class="max-w-4xl mx-auto flex items-center gap-4">
            <div class="flex-1">
                <div class="flex justify-between text-white text-sm mb-2">
                    <span id="progressText">Tema 1 de 8</span>
                    <span id="scoreText">Puntuación: 0/100</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="progressBar" style="width: 0%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="min-h-screen flex items-center justify-center p-4 pt-24">
        <div id="screen-welcome" class="glass-card p-8 md:p-12 max-w-2xl w-full text-center">
            <div class="mb-6"><span class="text-6xl">🎓</span></div>
            <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-800 serif">English for Adults</h1>
            <p class="text-xl text-gray-600 mb-2">Curso Interactivo Nivel A1-A2</p>
            <div class="flex justify-center gap-3 mb-8">
                <span class="badge badge-beginner">🌱 Principiante</span>
                <span class="badge badge-elementary">📈 Básico</span>
            </div>
            <p class="text-gray-600 mb-8 leading-relaxed">Diseñado especialmente para adultos. Aprende inglés de forma práctica, sin complicaciones y a tu propio ritmo. ¡Comencemos!</p>
            <button onclick="startCourse()" class="px-8 py-4 bg-blue-600 text-white rounded-full font-semibold text-lg hover:bg-blue-700 transition-all transform hover:scale-105 shadow-lg">Comenzar Curso <i class="fas fa-arrow-right ml-2"></i></button>
        </div>

        <div id="screen-topics" class="glass-card p-8 max-w-4xl w-full hidden">
            <h2 class="text-3xl font-bold mb-2 text-gray-800 text-center">📚 Selecciona un Tema</h2>
            <p class="text-gray-600 text-center mb-8">Completa cada módulo para desbloquear el siguiente</p>
            <div class="grid md:grid-cols-2 gap-4" id="topicsGrid"></div>
        </div>

        <div id="screen-lesson" class="glass-card p-8 max-w-3xl w-full hidden">
            <div class="flex items-center gap-3 mb-6">
                <button onclick="showTopics()" class="text-gray-500 hover:text-gray-700"><i class="fas fa-arrow-left text-xl"></i></button>
                <span class="badge" id="lessonBadge">A1</span>
                <h2 class="text-2xl font-bold text-gray-800" id="lessonTitle">Título</h2>
            </div>
            <div id="lessonContent" class="space-y-6"></div>
            <div class="mt-8 flex justify-between">
                <button onclick="previousSlide()" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-full font-medium hover:bg-gray-300 transition" id="prevBtn"><i class="fas fa-arrow-left mr-2"></i> Anterior</button>
                <button onclick="nextSlide()" class="px-6 py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition" id="nextBtn">Siguiente <i class="fas fa-arrow-right ml-2"></i></button>
            </div>
        </div>

        <div id="screen-quiz" class="glass-card p-8 max-w-2xl w-full hidden">
            <div class="text-center mb-6">
                <span class="text-4xl">📝</span>
                <h2 class="text-2xl font-bold text-gray-800 mt-2">Evaluación Rápida</h2>
                <p class="text-gray-600">Responde correctamente para ganar puntos</p>
                <p class="text-sm text-blue-600 mt-2" id="quizProgress">Responde las 3 preguntas</p>
            </div>
            <div id="quizContent" class="space-y-6"></div>
            <div id="quizResult" class="hidden mt-6 p-6 rounded-2xl text-center"></div>
            <div id="quizActions" class="hidden mt-6 text-center">
                <button onclick="finishTopic()" class="px-8 py-3 bg-blue-600 text-white rounded-full font-semibold hover:bg-blue-700 transition">Continuar <i class="fas fa-arrow-right ml-2"></i></button>
            </div>
        </div>

        <div id="screen-final" class="glass-card p-8 md:p-12 max-w-2xl w-full text-center hidden">
            <div class="mb-6"><span class="text-6xl">🏆</span></div>
            <h2 class="text-3xl font-bold mb-4 text-gray-800">¡Felicitaciones!</h2>
            <p class="text-gray-600 mb-8">Has completado el curso. Esta es tu puntuación final:</p>
            <div class="flex justify-center mb-8">
                <div class="score-circle" id="finalScoreCircle" style="--score-deg: 0deg;">
                    <span class="score-text" id="finalScoreText">0%</span>
                </div>
            </div>
            <div id="finalMessage" class="mb-8 p-6 rounded-2xl bg-blue-50 text-blue-800"></div>
            <div class="flex gap-4 justify-center">
                <button onclick="restartCourse()" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-full font-medium hover:bg-gray-300 transition"><i class="fas fa-redo mr-2"></i> Repetir Curso</button>
                <button onclick="showTopics()" class="px-6 py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition">Ver Temas <i class="fas fa-list ml-2"></i></button>
            </div>
        </div>
    </div>

    <script>
        const courseData = {
            topics: [
                {
                    id: 1, title: "Saludos y Presentaciones", level: "A1", icon: "👋", description: "Aprende a saludar y presentarte en inglés",
                    slides: [
                        { type: "vocabulary", title: "Saludos Básicos", content: [{ en: "Hello / Hi", es: "Hola", phonetic: "/həˈloʊ/ /haɪ/" }, { en: "Good morning", es: "Buenos días", phonetic: "/ɡʊd ˈmɔːrnɪŋ/" }, { en: "Good afternoon", es: "Buenas tardes", phonetic: "/ɡʊd ˌæftərˈnuːn/" }, { en: "Good evening", es: "Buenas noches (saludo)", phonetic: "/ɡʊd ˈiːvnɪŋ/" }, { en: "Goodbye / Bye", es: "Adiós", phonetic: "/ˌɡʊdˈbaɪ/ /baɪ/" }] },
                        { type: "dialogue", title: "Diálogo Práctico", dialogue: [{ speaker: "A", text: "Hello! My name is John." }, { speaker: "B", text: "Hi John! I'm Maria. Nice to meet you." }, { speaker: "A", text: "Nice to meet you too. How are you?" }, { speaker: "B", text: "I'm fine, thank you. And you?" }, { speaker: "A", text: "I'm good, thanks!" }], translation: "¡Hola! Me llamo John. / ¡Hola John! Soy María. Mucho gusto. / Mucho gusto también. ¿Cómo estás? / Estoy bien, gracias. ¿Y tú? / ¡Estoy bien, gracias!" },
                        { type: "tips", title: "Consejo Cultural", content: "En inglés, 'How are you?' es un saludo, no una pregunta literal. La respuesta corta 'Fine, thanks' es perfectamente aceptable." }
                    ],
                    quiz: [
                        { question: "¿Cómo se dice 'Buenos días' en inglés?", options: ["Good night", "Good morning", "Good afternoon", "Hello"], correct: 1, points: 10 },
                        { question: "Completa: '______ to meet you' (Mucho gusto)", options: ["Good", "Fine", "Nice", "Hello"], correct: 2, points: 10 },
                        { question: "¿Cuál es la respuesta apropiada a 'How are you?'?", options: ["My name is...", "I'm fine, thanks", "Good morning", "Bye bye"], correct: 1, points: 10 }
                    ]
                },
                {
                    id: 2, title: "Números y Fechas", level: "A1", icon: "🔢", description: "Números del 1-100 y cómo decir fechas", locked: true,
                    slides: [
                        { type: "vocabulary", title: "Números Cardinales", content: [{ en: "One, Two, Three", es: "Uno, Dos, Tres", phonetic: "/wʌn/ /tuː/ /θriː/" }, { en: "Eleven, Twelve, Thirteen", es: "Once, Doce, Trece", phonetic: "/ɪˈlevən/ /twelv/ /ˌθɜːrˈtiːn/" }, { en: "Twenty, Thirty, Forty", es: "Veinte, Treinta, Cuarenta", phonetic: "/ˈtwenti/ /ˈθɜːrti/ /ˈfɔːrti/" }, { en: "One hundred", es: "Cien", phonetic: "/wʌn ˈhʌndrəd/" }] },
                        { type: "vocabulary", title: "Meses del Año", content: [{ en: "January, February, March", es: "Enero, Febrero, Marzo" }, { en: "April, May, June", es: "Abril, Mayo, Junio" }, { en: "July, August, September", es: "Julio, Agosto, Septiembre" }, { en: "October, November, December", es: "Octubre, Noviembre, Diciembre" }] }
                    ],
                    quiz: [
                        { question: "¿Cómo se dice '25' en inglés?", options: ["Twenty-five", "Thirty-five", "Fifteen", "Fifty"], correct: 0, points: 10 },
                        { question: "¿En qué mes estamos si hoy es 'October 15th'?", options: ["Noviembre", "Septiembre", "Octubre", "Agosto"], correct: 2, points: 10 }
                    ]
                },
                {
                    id: 3, title: "La Familia", level: "A1", icon: "👨‍👩‍👧‍👦", description: "Vocabulario familiar y posesivos", locked: true,
                    slides: [
                        { type: "vocabulary", title: "Miembros de la Familia", content: [{ en: "Mother / Mom", es: "Madre / Mamá", phonetic: "/ˈmʌðər/ /mɑːm/" }, { en: "Father / Dad", es: "Padre / Papá", phonetic: "/ˈfɑːðər/ /dæd/" }, { en: "Sister / Brother", es: "Hermana / Hermano" }, { en: "Grandmother / Grandfather", es: "Abuela / Abuelo" }, { en: "Husband / Wife", es: "Esposo / Esposa" }] },
                        { type: "grammar", title: "Pronombres Posesivos", content: [{ rule: "My", example: "My mother", translation: "Mi madre" }, { rule: "Your", example: "Your father", translation: "Tu padre" }, { rule: "His", example: "His brother", translation: "Su hermano (de él)" }, { rule: "Her", example: "Her sister", translation: "Su hermana (de ella)" }, { rule: "Our", example: "Our family", translation: "Nuestra familia" }] }
                    ],
                    quiz: [
                        { question: "Completa: 'This is ______ father' (Este es MI padre)", options: ["your", "his", "my", "her"], correct: 2, points: 10 },
                        { question: "¿Cómo se dice 'hermano' en inglés?", options: ["Sister", "Brother", "Father", "Mother"], correct: 1, points: 10 }
                    ]
                },
                {
                    id: 4, title: "En el Restaurante", level: "A2", icon: "🍽️", description: "Pedir comida y bebida educadamente", locked: true,
                    slides: [
                        { type: "vocabulary", title: "En el Restaurante", content: [{ en: "Menu", es: "Menú" }, { en: "Waiter / Waitress", es: "Mesero / Mesera" }, { en: "Bill / Check", es: "Cuenta" }, { en: "Tip", es: "Propina" }] },
                        { type: "dialogue", title: "Haciendo un Pedido", dialogue: [{ speaker: "Waiter", text: "Good evening! Are you ready to order?" }, { speaker: "Customer", text: "Yes, please. I'd like a salad and water." }, { speaker: "Waiter", text: "Would you like anything else?" }, { speaker: "Customer", text: "No, thank you. That's all." }], translation: "¡Buenas noches! ¿Están listos para ordenar? / Sí, por favor. Me gustaría una ensalada y agua. / ¿Desea algo más? / No, gracias. Eso es todo." }
                    ],
                    quiz: [
                        { question: "'I'd like...' significa:", options: ["No me gusta", "Me gustaría", "Tengo hambre", "La cuenta por favor"], correct: 1, points: 15 },
                        { question: "¿Cómo pides la cuenta educadamente?", options: ["Give me money!", "The check, please", "I want pay", "Money now"], correct: 1, points: 15 }
                    ]
                },
                {
                    id: 5, title: "Horarios y Rutina", level: "A2", icon: "⏰", description: "Decir la hora y describir tu día", locked: true,
                    slides: [
                        { type: "vocabulary", title: "La Hora", content: [{ en: "What time is it?", es: "¿Qué hora es?" }, { en: "It's 3 o'clock", es: "Son las 3 en punto" }, { en: "It's half past 4", es: "Son las 4 y media" }, { en: "It's quarter to 5", es: "Son las 5 menos cuarto" }, { en: "In the morning / afternoon / evening", es: "De la mañana / tarde / noche" }] },
                        { type: "vocabulary", title: "Rutina Diaria", content: [{ en: "I wake up at 7", es: "Me despierto a las 7" }, { en: "I have breakfast", es: "Desayuno" }, { en: "I go to work", es: "Voy al trabajo" }, { en: "I have lunch", es: "Almuerzo" }, { en: "I go to bed", es: "Me acuesto" }] }
                    ],
                    quiz: [
                        { question: "'Half past 3' es:", options: ["3:15", "3:30", "3:45", "2:30"], correct: 1, points: 15 },
                        { question: "Completa: 'I ______ up at 6 AM' (Me despierto)", options: ["wake", "go", "have", "get"], correct: 0, points: 15 }
                    ]
                },
                {
                    id: 6, title: "Compras y Precios", level: "A2", icon: "🛍️", description: "Ir de compras y preguntar precios", locked: true,
                    slides: [
                        { type: "vocabulary", title: "En la Tienda", content: [{ en: "How much is this?", es: "¿Cuánto cuesta esto?" }, { en: "It's too expensive", es: "Es muy caro" }, { en: "Do you have a discount?", es: "¿Tiene descuento?" }, { en: "Can I try it on?", es: "¿Puedo probármelo?" }, { en: "I'll take it", es: "Me lo llevo" }] },
                        { type: "vocabulary", title: "Números Ordinales (Precios)", content: [{ en: "$10.99 - Ten ninety-nine", es: "Diez dólares con noventa y nueve" }, { en: "$25.00 - Twenty-five dollars", es: "Veinticinco dólares" }, { en: "Cash or card?", es: "¿Efectivo o tarjeta?" }] }
                    ],
                    quiz: [
                        { question: "'How much is this?' se usa para:", options: ["Preguntar la talla", "Preguntar el precio", "Pedir descuento", "Probarse ropa"], correct: 1, points: 15 },
                        { question: "¿Cómo dices '$15.50' en inglés?", options: ["Fifteen fifty", "Fifteen and fifty", "One five fifty", "Fifteen dollars fifty"], correct: 0, points: 15 }
                    ]
                },
                {
                    id: 7, title: "Viajes y Direcciones", level: "A2", icon: "✈️", description: "Preguntar direcciones y viajar", locked: true,
                    slides: [
                        { type: "vocabulary", title: "Preguntando Direcciones", content: [{ en: "Excuse me, where is...?", es: "Disculpe, dónde está...?" }, { en: "Turn left / right", es: "Gire a la izquierda / derecha" }, { en: "Go straight", es: "Siga derecho" }, { en: "It's on the corner", es: "Está en la esquina" }, { en: "How far is it?", es: "¿Qué tan lejos está?" }] },
                        { type: "vocabulary", title: "Transporte", content: [{ en: "Bus / Train / Taxi", es: "Autobús / Tren / Taxi" }, { en: "Airport / Station", es: "Aeropuerto / Estación" }, { en: "Ticket / Passport", es: "Boleto / Pasaporte" }, { en: "Round trip", es: "Ida y vuelta" }] }
                    ],
                    quiz: [
                        { question: "'Turn left' significa:", options: ["Siga derecho", "Gire a la izquierda", "Gire a la derecha", "Pare"], correct: 1, points: 15 },
                        { question: "¿Cómo pides ayuda para encontrar un lugar?", options: ["Help me now!", "Excuse me, where is...?", "I am lost!", "Where you go?"], correct: 1, points: 15 }
                    ]
                },
                {
                    id: 8, title: "El Tiempo y Clima", level: "A2", icon: "🌤️", description: "Describir el clima y hacer planes", locked: true,
                    slides: [
                        { type: "vocabulary", title: "El Clima", content: [{ en: "What's the weather like?", es: "¿Cómo está el clima?" }, { en: "It's sunny / rainy / cloudy", es: "Está soleado / lluvioso / nublado" }, { en: "It's hot / cold / warm", es: "Hace calor / frío / templado" }, { en: "Temperature", es: "Temperatura" }] },
                        { type: "dialogue", title: "Hablando del Tiempo", dialogue: [{ speaker: "A", text: "Nice day, isn't it?" }, { speaker: "B", text: "Yes, it's beautiful! Perfect for a walk." }, { speaker: "A", text: "Do you think it will rain tomorrow?" }, { speaker: "B", text: "The forecast says sunny all week!" }], translation: "Lindo día, ¿no? / ¡Sí, está hermoso! Perfecto para caminar. / ¿Crees que lloverá mañana? / ¡El pronóstico dice soleado toda la semana!" }
                    ],
                    quiz: [
                        { question: "'It's raining' significa:", options: ["Está nevando", "Está lloviendo", "Está soleado", "Hace viento"], correct: 1, points: 15 },
                        { question: "¿Cómo preguntas por el clima?", options: ["What time is it?", "What's the weather like?", "How are you?", "Where is the sun?"], correct: 1, points: 15 }
                    ]
                }
            ]
        };

        let currentTopic = 0, currentSlide = 0, totalScore = 0, maxScore = 0, completedTopics = [], answeredQuestions = 0, voices = [];

        function init() {
            calculateMaxScore();
            renderTopics();
            loadVoices();
        }

        function loadVoices() {
            voices = window.speechSynthesis.getVoices();
            if (voices.length === 0) window.speechSynthesis.onvoiceschanged = () => voices = window.speechSynthesis.getVoices();
        }

        function calculateMaxScore() {
            courseData.topics.forEach(topic => { if (topic.quiz) topic.quiz.forEach(q => maxScore += q.points); });
        }

        function startCourse() {
            document.getElementById('screen-welcome').classList.add('hidden');
            document.getElementById('screen-topics').classList.remove('hidden');
            updateProgress();
        }

        function renderTopics() {
            const grid = document.getElementById('topicsGrid');
            grid.innerHTML = courseData.topics.map((topic, index) => {
                const isLocked = topic.locked && !completedTopics.includes(index);
                const isCompleted = completedTopics.includes(index);
                const canStart = index === 0 || completedTopics.includes(index - 1);
                return `<div class="topic-card glass-card p-6 ${isLocked ? 'locked' : ''} ${isCompleted ? 'completed' : ''}" onclick="${canStart && !isLocked ? `startTopic(${index})` : ''}"><div class="flex items-center gap-4"><span class="text-4xl">${isCompleted ? '✅' : isLocked ? '🔒' : topic.icon}</span><div class="flex-1"><div class="flex items-center gap-2 mb-1"><span class="badge ${topic.level === 'A1' ? 'badge-beginner' : 'badge-elementary'}">${topic.level}</span>${isCompleted ? '<span class="text-green-600 text-sm font-bold">✓ Completado</span>' : ''}</div><h3 class="text-lg font-bold text-gray-800">${topic.title}</h3><p class="text-gray-600 text-sm">${topic.description}</p></div></div></div>`;
            }).join('');
        }

        function startTopic(index) {
            currentTopic = index; currentSlide = 0; answeredQuestions = 0;
            document.getElementById('screen-topics').classList.add('hidden');
            document.getElementById('screen-lesson').classList.remove('hidden');
            renderSlide();
            updateProgress();
        }

        function renderSlide() {
            const topic = courseData.topics[currentTopic], slide = topic.slides[currentSlide];
            document.getElementById('lessonBadge').textContent = topic.level;
            document.getElementById('lessonBadge').className = `badge ${topic.level === 'A1' ? 'badge-beginner' : 'badge-elementary'}`;
            document.getElementById('lessonTitle').textContent = slide.title;
            const contentDiv = document.getElementById('lessonContent');
            if (slide.type === 'vocabulary') {
                contentDiv.innerHTML = `<div class="grid gap-4">${slide.content.map(item => `<div class="p-4 bg-blue-50 rounded-xl flex items-center justify-between group hover:bg-blue-100 transition"><div><div class="flex items-center gap-3"><button onclick="speak('${item.en.replace(/'/g, "\\'")}')" class="audio-btn"><i class="fas fa-volume-up"></i></button><div><p class="text-xl font-bold text-gray-800">${item.en}</p><p class="text-blue-600 text-sm">${item.phonetic || ''}</p></div></div></div><p class="text-gray-600 text-right">${item.es}</p></div>`).join('')}</div>`;
            } else if (slide.type === 'dialogue') {
                contentDiv.innerHTML = `<div class="space-y-4 mb-6">${slide.dialogue.map(line => `<div class="flex gap-3 ${line.speaker === 'A' || line.speaker === 'Customer' ? 'flex-row' : 'flex-row-reverse'}"><div class="w-10 h-10 rounded-full ${line.speaker === 'A' || line.speaker === 'Customer' ? 'bg-blue-500' : 'bg-green-500'} flex items-center justify-center text-white font-bold">${line.speaker[0]}</div><div class="flex-1 p-4 rounded-2xl ${line.speaker === 'A' || line.speaker === 'Customer' ? 'bg-blue-100 rounded-tl-none' : 'bg-green-100 rounded-tr-none'}"><p class="text-gray-800">${line.text}</p><button onclick="speak('${line.text.replace(/'/g, "\\'")}')" class="mt-2 text-blue-600 hover:text-blue-800"><i class="fas fa-volume-up"></i> Escuchar</button></div></div>`).join('')}</div><div class="p-4 bg-gray-100 rounded-xl"><p class="text-gray-600 text-sm"><strong>Traducción:</strong> ${slide.translation}</p></div>`;
            } else if (slide.type === 'grammar') {
                contentDiv.innerHTML = `<div class="grid gap-4">${slide.content.map(item => `<div class="p-4 bg-purple-50 rounded-xl"><div class="flex items-center gap-4"><span class="text-2xl font-bold text-purple-600">${item.rule}</span><div><p class="text-gray-800 font-medium">${item.example}</p><p class="text-gray-600 text-sm">${item.translation}</p></div></div></div>`).join('')}</div>`;
            } else if (slide.type === 'tips') {
                contentDiv.innerHTML = `<div class="p-6 bg-amber-50 rounded-2xl border-2 border-amber-200"><div class="flex items-start gap-4"><span class="text-4xl">💡</span><div><h4 class="font-bold text-amber-800 mb-2">Consejo Cultural</h4><p class="text-amber-700">${slide.content}</p></div></div></div>`;
            }
            document.getElementById('prevBtn').style.visibility = currentSlide === 0 ? 'hidden' : 'visible';
            const isLastSlide = currentSlide === topic.slides.length - 1;
            document.getElementById('nextBtn').innerHTML = isLastSlide ? 'Ir al Quiz <i class="fas fa-arrow-right ml-2"></i>' : 'Siguiente <i class="fas fa-arrow-right ml-2"></i>';
        }

        function nextSlide() {
            const topic = courseData.topics[currentTopic];
            if (currentSlide < topic.slides.length - 1) { currentSlide++; renderSlide(); } else startQuiz();
        }

        function previousSlide() { if (currentSlide > 0) { currentSlide--; renderSlide(); } }

        function startQuiz() {
            document.getElementById('screen-lesson').classList.add('hidden');
            document.getElementById('screen-quiz').classList.remove('hidden');
            answeredQuestions = 0;
            document.getElementById('quizResult').classList.add('hidden');
            document.getElementById('quizActions').classList.add('hidden');
            renderQuiz();
        }

        function renderQuiz() {
            const topic = courseData.topics[currentTopic];
            document.getElementById('quizProgress').textContent = `Responde las ${topic.quiz.length} preguntas`;
            document.getElementById('quizContent').innerHTML = topic.quiz.map((q, idx) => `<div class="quiz-question" id="question-${idx}" data-answered="false"><p class="text-lg font-medium text-gray-800 mb-4">${idx + 1}. ${q.question}</p><div class="space-y-2">${q.options.map((opt, optIdx) => `<button class="option-btn w-full p-4 rounded-xl text-left flex items-center gap-3" onclick="checkAnswer(${idx}, ${optIdx}, ${q.points})"><span class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold text-gray-600">${String.fromCharCode(65 + optIdx)}</span><span>${opt}</span></button>`).join('')}</div></div>`).join('');
        }

        function checkAnswer(questionIdx, selectedIdx, points) {
            const topic = courseData.topics[currentTopic], question = topic.quiz[questionIdx], isCorrect = selectedIdx === question.correct, questionDiv = document.getElementById(`question-${questionIdx}`);
            if (questionDiv.getAttribute('data-answered') === 'true') return;
            questionDiv.setAttribute('data-answered', 'true'); answeredQuestions++;
            const buttons = questionDiv.querySelectorAll('.option-btn');
            buttons.forEach((btn, idx) => {
                btn.classList.add('disabled');
                if (idx === question.correct) btn.classList.add('correct');
                else if (idx === selectedIdx && !isCorrect) btn.classList.add('incorrect');
            });
            if (isCorrect) { totalScore += points; createEmojis('✅', 5); } else createEmojis('❌', 3);
            updateProgress();
            if (answeredQuestions === topic.quiz.length) setTimeout(showQuizResult, 1000);
        }

        function showQuizResult() {
            const topic = courseData.topics[currentTopic], correctAnswers = document.querySelectorAll('.option-btn.correct').length, total = topic.quiz.length;
            document.getElementById('quizResult').innerHTML = `<h3 class="text-2xl font-bold mb-2 ${correctAnswers >= total/2 ? 'text-green-600' : 'text-amber-600'}">${correctAnswers >= total/2 ? '🎉 ¡Bien hecho!' : '💪 Sigue practicando'}</h3><p class="text-gray-600 mb-4">Respondiste correctamente ${correctAnswers} de ${total} preguntas</p><p class="text-blue-600 font-semibold">${correctAnswers === total ? '¡Perfecto!' : '¡Sigue así!'}</p>`;
            document.getElementById('quizResult').classList.remove('hidden');
            document.getElementById('quizActions').classList.remove('hidden');
        }

        function finishTopic() {
            if (!completedTopics.includes(currentTopic)) {
                completedTopics.push(currentTopic);
                if (currentTopic < courseData.topics.length - 1) courseData.topics[currentTopic + 1].locked = false;
            }
            document.getElementById('screen-quiz').classList.add('hidden');
            if (completedTopics.length === courseData.topics.length) showFinalScore();
            else { document.getElementById('screen-topics').classList.remove('hidden'); renderTopics(); updateProgress(); }
        }

        function showFinalScore() {
            document.getElementById('screen-final').classList.remove('hidden');
            const percentage = Math.round((totalScore / maxScore) * 100), degrees = (percentage / 100) * 360;
            document.getElementById('finalScoreCircle').style.setProperty('--score-deg', `${degrees}deg`);
            document.getElementById('finalScoreText').textContent = `${percentage}%`;
            const messageDiv = document.getElementById('finalMessage');
            if (percentage >= 80) { messageDiv.innerHTML = `<h3 class="text-xl font-bold mb-2">🏆 ¡Excelente trabajo!</h3><p>Has dominado los conceptos básicos del inglés. Estás listo para el nivel A2-B1.</p>`; celebrate(); }
            else if (percentage >= 60) messageDiv.innerHTML = `<h3 class="text-xl font-bold mb-2">👍 ¡Buen progreso!</h3><p>Tienes una buena base. Repasa los temas donde tuviste dificultades.</p>`;
            else messageDiv.innerHTML = `<h3 class="text-xl font-bold mb-2">📚 Sigue practicando</h3><p>El inglés requiere constancia. Repite el curso y verás mejoras.</p>`;
        }

        function showTopics() {
            document.querySelectorAll('#screen-welcome, #screen-lesson, #screen-quiz, #screen-final').forEach(s => s.classList.add('hidden'));
            document.getElementById('screen-topics').classList.remove('hidden');
            renderTopics();
        }

        function restartCourse() {
            currentTopic = 0; currentSlide = 0; totalScore = 0; completedTopics = []; answeredQuestions = 0;
            courseData.topics.forEach((t, i) => { if (i > 0) t.locked = true; });
            document.getElementById('screen-final').classList.add('hidden');
            document.getElementById('screen-welcome').classList.remove('hidden');
            updateProgress();
        }

        function updateProgress() {
            const progress = (completedTopics.length / courseData.topics.length) * 100;
            document.getElementById('progressBar').style.width = `${progress}%`;
            document.getElementById('progressText').textContent = `Tema ${completedTopics.length + 1} de ${courseData.topics.length}`;
            document.getElementById('scoreText').textContent = `Puntuación: ${totalScore}/${maxScore}`;
        }

        function speak(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US'; utterance.rate = 0.9; utterance.pitch = 1;
                if (voices.length === 0) voices = window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(v => v.name.includes('Google US English')) || voices.find(v => v.name.includes('Samantha')) || voices.find(v => v.name.includes('Daniel')) || voices.find(v => v.lang.startsWith('en'));
                if (preferredVoice) utterance.voice = preferredVoice;
                window.speechSynthesis.speak(utterance);
            }
        }

        function createEmojis(emoji, count) {
            for (let i = 0; i < count; i++) {
                setTimeout(() => {
                    const el = document.createElement('div');
                    el.className = 'floating-emoji'; el.textContent = emoji;
                    el.style.left = (Math.random() * window.innerWidth) + 'px';
                    el.style.top = (window.innerHeight - 100) + 'px';
                    document.body.appendChild(el); setTimeout(() => el.remove(), 3000);
                }, i * 100);
            }
        }

        function celebrate() {
            const colors = ['#10b981', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6'];
            for (let i = 0; i < 100; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.className = 'confetti';
                    confetti.style.left = Math.random() * 100 + 'vw';
                    confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
                    document.body.appendChild(confetti); setTimeout(() => confetti.remove(), 3000);
                }, i * 20);
            }
        }

        init();
    </script>
</body>
</html>
